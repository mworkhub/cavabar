# ─── Supabase ────────────────────────────────────────────────
# Public — safe to expose in browser (protected by Supabase RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# DANGER: never prefix with NEXT_PUBLIC_ — server-only use only
# Use only in API Routes, Server Actions, or Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── hCaptcha ────────────────────────────────────────────────
# Register at https://dashboard.hcaptcha.com → Sites
# Test keys (always pass): sitekey=10000000-ffff-ffff-ffff-000000000001 / secret=0x000...0
NEXT_PUBLIC_HCAPTCHA_SITEKEY=your_hcaptcha_site_key_here
HCAPTCHA_SECRET=your_hcaptcha_secret_key_here
